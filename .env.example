# Copy to .env (git-ignored). Values here are placeholders — never commit real ones.
# ------------------------------------------------------------------ mode
PIPELINE_ENV=local                 # local | cloud
BQ_BACKEND=duckdb                  # duckdb (local) | bigquery
RAW_FORMAT=jsonl                   # jsonl (local simulator) | parquet (AWS DMS)
TRANSFER_MODE=airflow_worker       # airflow_worker | glue_python_shell
CDC_DELETE_STRATEGY=soft           # soft | hard
CDC_MAX_REJECTED_RATIO=0.5         # demo data contains malformed rows; use ~0.01 in prod
CDC_WATERMARK_OVERLAP_MINUTES=15

# ------------------------------------------------------------------ storage (cloud values)
# RAW_BUCKET_URI=s3://your-raw-bucket-name
# PROCESSED_BUCKET_URI=s3://your-processed-bucket-name
# GCS_STAGING_URI=gs://your-staging-bucket-name

# ------------------------------------------------------------------ AWS
AWS_REGION=us-east-1
GLUE_TRANSFORM_JOB_NAME=your-cdc-transform-glue-job-name
TRANSFER_GLUE_JOB_NAME=your-transfer-glue-job-name
# Secrets Manager secret id holding the GCP WIF credential config (see docs/security.md)
GCP_CREDENTIALS_SECRET_ID=

# ------------------------------------------------------------------ GCP / BigQuery
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=US
BQ_STAGING_DATASET=cdc_staging
BQ_FINAL_DATASET=analytics
BQ_AUDIT_DATASET=cdc_audit

# ------------------------------------------------------------------ Airflow
CDC_DAG_SCHEDULE="0 * * * *"
CDC_SLA_MINUTES=90
CDC_TASK_RETRIES=3
ALERT_EMAILS=
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_ON_SUCCESS=false

# ------------------------------------------------------------------ local PostgreSQL (Docker)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=appdb
SOURCE_DB_ADMIN_USER=postgres
SOURCE_DB_ADMIN_PASSWORD=change-me-local-only
